# Copy to .env and adjust if needed: cp .env.example .env

# Database backend: mysql (default) or mongodb
DB_TYPE=mysql

# MySQL (docker-compose service: db)
MYSQL_ROOT_PASSWORD=portfolio_root
MYSQL_DATABASE=portfolio
MYSQL_PORT=3306

# App database connection (used by portfolio app container)
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=portfolio_root
DB_NAME=portfolio

# MongoDB (docker-compose service: mongo) — set DB_TYPE=mongodb to use
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=portfolio
MONGO_PORT=27017

# App server (use 3000; PORT=0 is treated as default 3000 at runtime)
PORT=3000
APP_PORT=3000

# Optional: wait for MySQL on startup (Docker)
DB_CONNECT_RETRIES=15
DB_CONNECT_DELAY_MS=2000

# Login DB presets (optional): localhost = host MySQL, docker = embedded/compose MySQL
# DB_HOST_LOCALHOST=host.docker.internal
# DB_HOST_DOCKER=127.0.0.1
# DB_PORT_LOCALHOST=3306
# DB_PORT_DOCKER=3306

# Single-image: embedded MariaDB is ON by default (Internal Docker DB / 127.0.0.1:3306).
# No MySQL port publish needed for the app. Optional host access:
#   -p 3307:3306   or   -P (random host port)   or   MYSQL_PUBLISH_PORT=random (hint in logs)
# EMBEDDED_MYSQL=true
# EMBEDDED_MYSQL_PORT=3306
# MYSQL_PUBLISH_PORT=random
# MYSQL_ROOT_PASSWORD=portfolio
# Compose sets EMBEDDED_MYSQL=false and uses service "db" instead.

# Logging: debug | info | warn | error
LOG_LEVEL=info

# App login (server-side). Defaults: APP_USER=amol, password admin if unset.
# Prefer APP_PASSWORD_HASH=scrypt$salt$hash (generate with: node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');const h=c.scryptSync('yourpass',s,64).toString('hex');console.log('scrypt$'+s+'$'+h)")
APP_USER=amol
APP_PASSWORD=admin
# APP_PASSWORD_HASH=
# SESSION_SECRET=change-me
# COOKIE_SECURE=false

# Comma-separated platforms excluded by default from UI charts/tables.
# Manually selecting a platform in filters includes it again.
# Matching is case-insensitive and ignores spaces (RealEstate == "Real Estate").
IGNORE_PLATFORM=PLOT,RealEstate
